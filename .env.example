# Copy to .env.local for local builds, or set these in Vercel > Project > Settings > Environment Variables.
# Both are public values: anything starting with VITE_ ends up in the browser bundle. Never put secrets here.

# Public address of the site, used for canonical links, link previews and the sitemap.
# On Vercel it defaults to the project's production domain, so set it only for a custom domain.
VITE_SITE_URL=

# Optional form service endpoint (for example a Formspree form URL). Empty: the contact form opens
# the visitor's email app addressed to the profile email instead.
VITE_CONTACT_ENDPOINT=
